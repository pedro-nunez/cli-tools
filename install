#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
bin_dir="${HOME}/.local/bin"

for script in literature/open_book literature/open_notes literature/open_paper git/push_repo git/pull_repo; do
    if [[ ! -x "$repo_dir/$script" ]]; then
        printf 'Not executable: %s\n' "$repo_dir/$script" >&2
        exit 1
    fi
done

mkdir -p "$bin_dir"

install_link() {
    local name="$1"
    local target="$repo_dir/$2"
    local destination="$bin_dir/$name"

    if [[ -L "$destination" && "$(readlink "$destination")" == "$target" ]]; then
        printf 'Already installed: %s\n' "$name"
    elif [[ -e "$destination" || -L "$destination" ]]; then
        printf 'Not replacing existing path: %s\n' "$destination" >&2
        return 1
    else
        ln -s "$target" "$destination"
        printf 'Installed: %s\n' "$name"
    fi
}

install_link b literature/open_book
install_link n literature/open_notes
install_link p literature/open_paper
install_link push git/push_repo
install_link pull git/pull_repo
